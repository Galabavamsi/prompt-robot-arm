<mujoco model="physical_ai_sorting_arm_ik">
  <!--
    Version 2 scene: a small teaching arm for inverse kinematics.
    This is not a real industrial robot model. It is intentionally simple so
    you can see the relationship between joints, end-effector targets, and IK.
  -->
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
  <option timestep="0.01" gravity="0 0 -9.81"/>

  <!-- Defaults apply to joints, geoms, and motors unless overridden below. -->
  <default>
    <joint damping="0.6" armature="0.02" limited="true"/>
    <geom friction="0.8 0.02 0.001"/>
    <motor ctrlrange="-2 2"/>
  </default>

  <!-- Visual materials: table, robot, colored boxes, translucent bins. -->
  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.92 0.92 0.90" rgb2="0.78 0.80 0.82" width="256" height="256"/>
    <material name="table_mat" texture="grid" texrepeat="4 4" reflectance="0.1"/>
    <material name="arm_mat" rgba="0.18 0.22 0.26 1"/>
    <material name="joint_mat" rgba="0.05 0.07 0.09 1"/>
    <material name="red_mat" rgba="0.85 0.12 0.10 1"/>
    <material name="blue_mat" rgba="0.10 0.28 0.85 1"/>
    <material name="green_mat" rgba="0.10 0.60 0.25 1"/>
    <material name="yellow_mat" rgba="0.95 0.75 0.12 1"/>
    <material name="bin_red_mat" rgba="0.85 0.12 0.10 0.22"/>
    <material name="bin_blue_mat" rgba="0.10 0.28 0.85 0.22"/>
    <material name="bin_green_mat" rgba="0.10 0.60 0.25 0.22"/>
    <material name="bin_yellow_mat" rgba="0.95 0.75 0.12 0.22"/>
    <material name="target_mat" rgba="1.0 1.0 1.0 0.35"/>
  </asset>

  <worldbody>
    <!-- Camera and lighting are part of the digital twin too. Later, camera
         images can become the input to perception or VLA models. -->
    <light name="key" pos="0 -2.5 4" dir="0 0 -1" diffuse="0.85 0.85 0.85"/>
    <camera name="overview" pos="0 -2.4 1.75" xyaxes="1 0 0 0 0.58 0.82"/>

    <geom name="floor" type="plane" size="2.2 2.2 0.05" material="table_mat"/>
    <geom name="table" type="box" pos="0 0 0.02" size="0.9 0.65 0.02" material="table_mat"/>

    <!--
      Robot arm hierarchy.
      MuJoCo bodies are nested: base -> shoulder -> elbow -> wrist -> gripper.
      Each hinge joint adds one controllable degree of freedom.
    -->
    <body name="arm_base" pos="-0.55 0 0.08">
      <geom name="base" type="cylinder" size="0.08 0.04" material="joint_mat"/>
      <joint name="base_yaw" type="hinge" axis="0 0 1" range="-145 145"/>

      <body name="shoulder" pos="0 0 0.07">
        <geom type="sphere" size="0.045" material="joint_mat"/>
        <joint name="shoulder_pitch" type="hinge" axis="0 1 0" range="-35 115"/>

        <body name="upper_arm" pos="0 0 0">
          <geom type="capsule" fromto="0 0 0 0.32 0 0" size="0.026" material="arm_mat"/>

          <body name="elbow" pos="0.32 0 0">
            <geom type="sphere" size="0.038" material="joint_mat"/>
            <joint name="elbow_pitch" type="hinge" axis="0 1 0" range="-130 130"/>

            <body name="forearm" pos="0 0 0">
              <geom type="capsule" fromto="0 0 0 0.30 0 0" size="0.023" material="arm_mat"/>

              <body name="wrist" pos="0.30 0 0">
                <geom type="sphere" size="0.03" material="joint_mat"/>
                <joint name="wrist_pitch" type="hinge" axis="0 1 0" range="-120 120"/>

                <body name="end_effector" pos="0.12 0 0">
                  <geom name="gripper_palm" type="box" size="0.045 0.018 0.012" material="joint_mat" contype="0" conaffinity="0"/>
                  <geom name="left_finger" type="box" pos="0.025 0.04 -0.025" size="0.01 0.008 0.035" material="joint_mat" contype="0" conaffinity="0"/>
                  <geom name="right_finger" type="box" pos="0.025 -0.04 -0.025" size="0.01 0.008 0.035" material="joint_mat" contype="0" conaffinity="0"/>
                  <!-- grasp_site is the tool-center point. The IK solver tries
                       to move this site to each pick/place target position. -->
                  <site name="grasp_site" pos="0.035 0 -0.065" size="0.012" rgba="1 1 1 0.7"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Visual marker for the current IK target. It is moved by Python. -->
    <body name="ik_target" mocap="true" pos="-0.35 -0.18 0.24">
      <geom type="sphere" size="0.018" material="target_mat" contype="0" conaffinity="0"/>
    </body>

    <!-- Boxes are free bodies: each has a 6-DOF free joint so it can move
         independently in the world. The script manually carries them for now. -->
    <body name="red_box" pos="-0.35 -0.18 0.09">
      <freejoint name="red_box_joint"/>
      <geom type="box" size="0.04 0.04 0.04" material="red_mat" mass="0.06"/>
    </body>
    <body name="blue_box" pos="-0.24 0.14 0.09">
      <freejoint name="blue_box_joint"/>
      <geom type="box" size="0.04 0.04 0.04" material="blue_mat" mass="0.06"/>
    </body>
    <body name="green_box" pos="-0.43 0.22 0.09">
      <freejoint name="green_box_joint"/>
      <geom type="box" size="0.04 0.04 0.04" material="green_mat" mass="0.06"/>
    </body>
    <body name="yellow_box" pos="-0.26 -0.02 0.09">
      <freejoint name="yellow_box_joint"/>
      <geom type="box" size="0.04 0.04 0.04" material="yellow_mat" mass="0.06"/>
    </body>

    <!-- Destination zones. They are visual targets, not physical containers yet. -->
    <body name="red_bin" pos="0.18 -0.33 0.055">
      <geom type="box" size="0.085 0.085 0.01" material="bin_red_mat" contype="0" conaffinity="0"/>
    </body>
    <body name="blue_bin" pos="0.18 -0.11 0.055">
      <geom type="box" size="0.085 0.085 0.01" material="bin_blue_mat" contype="0" conaffinity="0"/>
    </body>
    <body name="green_bin" pos="0.18 0.11 0.055">
      <geom type="box" size="0.085 0.085 0.01" material="bin_green_mat" contype="0" conaffinity="0"/>
    </body>
    <body name="yellow_bin" pos="0.18 0.33 0.055">
      <geom type="box" size="0.085 0.085 0.01" material="bin_yellow_mat" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <!-- Motors are declared for future control work. The current IK script writes
       joint positions directly, then we can upgrade to actuator control later. -->
  <actuator>
    <motor name="base_yaw_motor" joint="base_yaw" gear="1"/>
    <motor name="shoulder_pitch_motor" joint="shoulder_pitch" gear="1"/>
    <motor name="elbow_pitch_motor" joint="elbow_pitch" gear="1"/>
    <motor name="wrist_pitch_motor" joint="wrist_pitch" gear="1"/>
  </actuator>
</mujoco>
