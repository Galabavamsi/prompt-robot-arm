<mujoco model="physical_ai_sorting_scara_ik">
  <!--
    Version 2 scene: a SCARA-style teaching robot for tabletop sorting.

    SCARA is easier than a full 6-DOF arm for this first robotics milestone:
    - two planar joints choose X/Y
    - one vertical slide chooses Z
    - the gripper points downward

    That matches colored-box sorting on a table and avoids the unstable
    dynamics we saw with the first pitch-elbow prototype.
  -->
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
  <option timestep="0.01" gravity="0 0 -9.81"/>

  <!-- The arm is used kinematically in Version 2, so arm geoms are visual-only.
       We will add real actuator dynamics later after the task logic is stable. -->
  <default>
    <joint damping="1.2" armature="0.02" limited="true"/>
    <geom friction="0.8 0.02 0.001"/>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.92 0.92 0.90" rgb2="0.78 0.80 0.82" width="256" height="256"/>
    <material name="table_mat" texture="grid" texrepeat="4 4" reflectance="0.1"/>
    <material name="base_mat" rgba="0.08 0.10 0.12 1"/>
    <material name="link1_mat" rgba="0.12 0.32 0.55 1"/>
    <material name="link2_mat" rgba="0.10 0.48 0.42 1"/>
    <material name="slide_mat" rgba="0.95 0.72 0.20 1"/>
    <material name="gripper_mat" rgba="0.04 0.04 0.05 1"/>
    <material name="red_mat" rgba="0.85 0.12 0.10 1"/>
    <material name="blue_mat" rgba="0.10 0.28 0.85 1"/>
    <material name="green_mat" rgba="0.10 0.60 0.25 1"/>
    <material name="yellow_mat" rgba="0.95 0.75 0.12 1"/>
    <material name="bin_red_mat" rgba="0.85 0.12 0.10 0.22"/>
    <material name="bin_blue_mat" rgba="0.10 0.28 0.85 0.22"/>
    <material name="bin_green_mat" rgba="0.10 0.60 0.25 0.22"/>
    <material name="bin_yellow_mat" rgba="0.95 0.75 0.12 0.22"/>
    <material name="target_mat" rgba="1.0 1.0 1.0 0.45"/>
  </asset>

  <worldbody>
    <!-- Camera and lighting are part of the digital twin. Later, this camera
         can be used for perception instead of simulator ground truth. -->
    <light name="key" pos="0 -2.5 4" dir="0 0 -1" diffuse="0.85 0.85 0.85"/>
    <camera name="overview" pos="0 -2.35 1.85" xyaxes="1 0 0 0 0.58 0.82"/>

    <geom name="floor" type="plane" size="2.2 2.2 0.05" material="table_mat"/>
    <geom name="table" type="box" pos="0 0 0.02" size="0.9 0.65 0.02" material="table_mat"/>

    <!--
      SCARA robot hierarchy.
      Joint 1: base_yaw rotates link 1 in the table plane.
      Joint 2: elbow_yaw rotates link 2 in the table plane.
      Joint 3: gripper_z slides the gripper up/down.
    -->
    <body name="arm_base" pos="-0.48 0 0.30">
      <geom name="base_column" type="cylinder" pos="0 0 -0.15" size="0.075 0.15" material="base_mat" contype="0" conaffinity="0"/>
      <joint name="base_yaw" type="hinge" axis="0 0 1" range="-170 170"/>

      <body name="link1" pos="0 0 0.10">
        <geom name="link1_bar" type="capsule" fromto="0 0 0 0.38 0 0" size="0.028" material="link1_mat" contype="0" conaffinity="0"/>
        <geom name="shoulder_hub" type="cylinder" size="0.045 0.018" material="base_mat" contype="0" conaffinity="0"/>

        <body name="elbow" pos="0.38 0 0">
          <geom name="elbow_hub" type="cylinder" size="0.04 0.018" material="base_mat" contype="0" conaffinity="0"/>
          <joint name="elbow_yaw" type="hinge" axis="0 0 1" range="-155 155"/>

          <body name="link2" pos="0 0 0">
            <geom name="link2_bar" type="capsule" fromto="0 0 0 0.36 0 0" size="0.024" material="link2_mat" contype="0" conaffinity="0"/>

            <body name="vertical_slide" pos="0.36 0 0">
              <joint name="gripper_z" type="slide" axis="0 0 1" range="-0.02 0.34"/>
              <geom name="slide_rail" type="cylinder" pos="0 0 -0.13" size="0.018 0.16" material="slide_mat" contype="0" conaffinity="0"/>

              <body name="end_effector" pos="0 0 -0.22">
                <geom name="gripper_palm" type="box" size="0.05 0.018 0.012" material="gripper_mat" contype="0" conaffinity="0"/>
                <geom name="left_finger" type="box" pos="0 0.04 -0.028" size="0.012 0.008 0.04" material="gripper_mat" contype="0" conaffinity="0"/>
                <geom name="right_finger" type="box" pos="0 -0.04 -0.028" size="0.012 0.008 0.04" material="gripper_mat" contype="0" conaffinity="0"/>
                <!-- grasp_site is the point the IK solver places on each box/bin. -->
                <site name="grasp_site" pos="0 0 -0.08" size="0.012" rgba="1 1 1 0.8"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Visual marker for the current IK target. It is moved by Python. -->
    <body name="ik_target" mocap="true" pos="-0.35 -0.18 0.24">
      <geom type="sphere" size="0.018" material="target_mat" contype="0" conaffinity="0"/>
    </body>

    <!-- Boxes are free bodies. The script attaches a box to the gripper while
         it is carried; later we can replace that with real gripper contacts. -->
    <body name="red_box" pos="-0.35 -0.18 0.09">
      <freejoint name="red_box_joint"/>
      <geom type="box" size="0.04 0.04 0.04" material="red_mat" mass="0.06"/>
    </body>
    <body name="blue_box" pos="-0.24 0.14 0.09">
      <freejoint name="blue_box_joint"/>
      <geom type="box" size="0.04 0.04 0.04" material="blue_mat" mass="0.06"/>
    </body>
    <body name="green_box" pos="-0.43 0.22 0.09">
      <freejoint name="green_box_joint"/>
      <geom type="box" size="0.04 0.04 0.04" material="green_mat" mass="0.06"/>
    </body>
    <body name="yellow_box" pos="-0.26 -0.02 0.09">
      <freejoint name="yellow_box_joint"/>
      <geom type="box" size="0.04 0.04 0.04" material="yellow_mat" mass="0.06"/>
    </body>

    <!-- Destination zones. They are visual targets, not physical containers yet. -->
    <body name="red_bin" pos="0.18 -0.33 0.055">
      <geom type="box" size="0.085 0.085 0.01" material="bin_red_mat" contype="0" conaffinity="0"/>
    </body>
    <body name="blue_bin" pos="0.18 -0.11 0.055">
      <geom type="box" size="0.085 0.085 0.01" material="bin_blue_mat" contype="0" conaffinity="0"/>
    </body>
    <body name="green_bin" pos="0.18 0.11 0.055">
      <geom type="box" size="0.085 0.085 0.01" material="bin_green_mat" contype="0" conaffinity="0"/>
    </body>
    <body name="yellow_bin" pos="0.18 0.33 0.055">
      <geom type="box" size="0.085 0.085 0.01" material="bin_yellow_mat" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
